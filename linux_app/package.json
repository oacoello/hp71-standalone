{
  "name": "calculadora-santa-barbara",
  "version": "1.0.1",
  "description": "Calculadora Santa Barbara - Versión 1.0 Junio 2026",
  "main": "main.js",
  "homepage": "https://local.santa-barbara-fdc",
  "author": {
    "name": "Desarrollo Mecatrónica UDH - V.I.M.M"
  },
  "license": "UNLICENSED",
  "scripts": {
    "pack:linux": "electron-builder --linux dir",
    "dist:deb": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis",
    "dist": "electron-builder --linux deb"
  },
  "build": {
    "appId": "hn.fah.santabarbara.fdc",
    "productName": "Calculadora Santa Barbara",
    "executableName": "calculadora-santa-barbara",
    "copyright": "Copyright © 2026 Universidad de Defensa de Honduras UDH",
    "icon": "icon_hp71b.png",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Desarrollo Mecatrónica UDH - V.I.M.M",
      "icon": "icon_hp71b.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon_hp71b.ico",
      "publisherName": [
        "Desarrollo Mecatrónica UDH - V.I.M.M"
      ]
    },
    "nsis": {
      "installerIcon": "icon_hp71b.ico",
      "uninstallerIcon": "icon_hp71b.ico",
      "installerHeaderIcon": "icon_hp71b.ico"
    },
    "files": [
      "main.js",
      "splash.html",
      "logo.png",
      "splash.gif",
      "icon_hp71b.png",
      "icon_hp71b.ico"
    ],
    "extraResources": [
      {
        "from": "../electron_payload",
        "to": "."
      }
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
